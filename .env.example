# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Django's cryptographic signing key. Generate a real one for local/prod use,
# e.g.: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Which settings module to load (config.settings.dev or config.settings.prod).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Set to True only for local development. Must be False in any deployed env.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve, e.g. localhost,example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres credentials used both by the `db` container itself and by
# DATABASE_URL below - keep them in sync.
POSTGRES_DB=wa_booking_agent
POSTGRES_USER=wa_booking_agent
POSTGRES_PASSWORD=change-me

# django-environ database URL: postgres://USER:PASSWORD@HOST:PORT/NAME
# Host is "db" when running via docker compose, "localhost" when running
# manage.py directly on your machine against a locally exposed Postgres port.
DATABASE_URL=postgres://wa_booking_agent:change-me@db:5432/wa_booking_agent

# Redis connection string, used for caching, Celery, and the health check.
REDIS_URL=redis://redis:6379/0

# Any string you choose - must match the "Verify token" you set for this
# app's webhook in the Meta App dashboard. See docs/whatsapp-setup.md.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me

# Your Meta App's App Secret, used to verify the X-Hub-Signature-256
# header on every incoming webhook POST. See docs/whatsapp-setup.md.
WHATSAPP_APP_SECRET=change-me

# Seconds to wait after an end user's most recent message before treating a
# burst of rapid-fire messages as "done" and replying. Optional, defaults to 5.
DEBOUNCE_WINDOW_SECONDS=5
